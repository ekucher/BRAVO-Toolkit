{
    "autoCompactWindow": 500000,
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Task|Write|Edit|NotebookEdit|mcp__codex-agent__.*",
                "hooks": [
                    {
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-agent-routing.ps1\"",
                        "type": "command",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/precompact-checkpoint.ps1\"",
                        "type": "command"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/save-task.ps1\"",
                        "type": "command"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "permission_prompt",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-slack.ps1\"",
                        "async": true,
                        "timeout": 15
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/save-task.ps1\"",
                        "type": "command"
                    },
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-slack.ps1\"",
                        "async": true,
                        "timeout": 15
                    },
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-ai-cost.ps1\"",
                        "async": true,
                        "timeout": 20
                    }
                ]
            }
        ]
    }
}