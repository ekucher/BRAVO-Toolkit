*.log
*.mdz
*.sha512
*.tmp
*.bak
BRAVO_OPERATION.lock
WinSCP.ini
LOGS/

# Tools\TOOLS_INTEGRITY.json — TOFU-базова лінія, створюється автоматично
# при першому запуску на кожному сервері (README.md розділ 1). Не плутати
# з Tools\TOOLS_MANIFEST.json (version-controlled, той трекається).
Tools/TOOLS_INTEGRITY.json

# Каталоги призначення бекапів (BRAVO.config: archiveDirs/bazaAppPaths/bazaWWWPaths) —
# створюються автоматично там, де реально лежить скрипт
# (pathSettings.ArchiveRoot/BackupRoot типово = каталог самого скрипта).
# При ручному запуску з робочої копії репозиторію це сам корінь
# репозиторію — без цього правила такий запуск засмічував би git status.
/MODEL/
/BLOG/
/BRAVOEXCH/
/BAZA/
/BAZA_WWW/

# Локальні налаштування IDE — особисті, не частина комплекту
.vscode/

# Результати збирання release-артефакту (ci\New-BRAVOReleaseArtifact.ps1) —
# генеруються з git archive, ніколи не комітяться.
artifacts/

# P0 Configuration Foundation (PR C): BRAVO.local.config — site-specific
# override-шар оператора (LIMSRoot/BackupRoot/креденшел-таргети/розклади
# тощо для КОНКРЕТНОГО сервера), той самий клас, що WinSCP.ini вище —
# ніколи не частина комплекту й не повинен потрапити в git при ручному
# запуску з робочої копії репозиторію. Трекається лише шаблон
# BRAVO.local.config.example.
BRAVO.local.config
