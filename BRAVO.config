# Єдиний файл конфігурації для BRAVO_ARCHIV.ps1 і BRAVO_MAINTENANCE.ps1
# Версія конфігурації: визначається VERSION.json

# Windows 7 / Server 2008 R2 and newer; Windows PowerShell 3.0 minimum.
# On Windows 7, WMF 5.1 is recommended.
# Каталог modules має бути розгорнутий поруч із виконуваними сценаріями.

param(
    [Parameter(Mandatory = $true)]
    [string]$ConfigRoot,

    # Каталог самого комплекту (скрипти, modules\, Tools\, VERSION.json).
    # Старі виклики без цього параметра прирівнюють його до ConfigRoot.
    [string]$RuntimeRoot
)

# Цей файл виконується обома основними скриптами як PowerShell-конфігурація.
#
# CODE IS NOT DATA. Від RuntimeRoot залежать ЛИШЕ ресурси самого комплекту
# (Tools\, modules\, маніфести). Виробничі корені даних — LIMSRoot,
# ArchiveRoot і BackupRoot — задаються нижче явно й НЕ виводяться ані з
# розташування комплекту, ані один з одного: комплект може лежати в
# C:\BRAVO, LIMS — на D:, архіви — на E:, і жодної фізичної залежності між
# ними немає.
$global:runtimeRoot = if ([string]::IsNullOrWhiteSpace($RuntimeRoot)) {
    [System.IO.Path]::GetFullPath($ConfigRoot)
} else {
    [System.IO.Path]::GetFullPath($RuntimeRoot)
}

# =============================================
# СПІЛЬНІ НАЛАШТУВАННЯ BRAVO
# =============================================

$global:bravoSettings = @{
    # Fallback для першого запуску. Після BRAVO_SETUP.ps1 фактичні значення
    # завантажуються з Windows Credential Manager і переживають заміну config.
    InstitutionName = "УСТАНОВА"
    InstitutionCode = "00000000"
    ArchivePrefix = "lab_v2412"
    NotificationProvider = "discord" # slack | discord
    NotificationMode = "all"       # none | errors_only | all
    NotificationRequestTimeoutSeconds = 30
    # Мапа severity -> канал сповіщень (GENERAL/ALERTS). Якщо стара
    # конфігурація не визначає цей ключ узагалі, BRAVO.Notifications
    # застосовує той самий безпечний дефолт самостійно.
    NotificationRouting = @{
        SUCCESS  = "general"
        WARNING  = "alerts"
        ERROR    = "alerts"
        CRITICAL = "alerts"
    }
}

# Секрети й локальні параметри установи не зберігаються у production-config.
# Тут вказані fallback-значення та назви записів Windows Credential Manager.
# Записи для поточного користувача і task account створює
# BRAVO_CREDENTIALS_SETUP.ps1 / BRAVO_SETUP.ps1.
$global:credentialSettings = @{
    HelperPath = Join-Path $global:runtimeRoot "modules\BRAVO.Credentials\BRAVO.Credentials.psd1"
    SetupScriptPath = Join-Path $global:runtimeRoot "BRAVO_CREDENTIALS_SETUP.ps1"
    Targets = @{
        SFTPLogin = "BRAVO_SFTP_LOGIN"
        SFTPPassword = "BRAVO_SFTP_PASSWORD"
        SMBLogin = "BRAVO_SMB_LOGIN"
        SMBPassword = "BRAVO_SMB_PASSWORD"
        SlackWebhook = "BRAVO_SLACK_URL"
        SlackWebhookGeneral = "BRAVO_SLACK_GENERAL_URL"
        SlackWebhookAlerts = "BRAVO_SLACK_ALERTS_URL"
        DiscordWebhook = "BRAVO_DISCORD_URL"
        DiscordWebhookGeneral = "BRAVO_DISCORD_GENERAL_URL"
        DiscordWebhookAlerts = "BRAVO_DISCORD_ALERTS_URL"
        ArchivePassword = "BRAVO_7Z_PASSWORD"
        InstitutionName = "BRAVO_INSTITUTION_NAME"
        InstitutionCode = "BRAVO_INSTITUTION_CODE"
        ArchivePrefix = "BRAVO_ARCHIVE_PREFIX"
    }
}

# Інформація про машину для Slack/Discord-повідомлень.
# Якщо зовнішні сервіси недоступні, скрипти продовжують роботу та вказують
# публічну IP-адресу як "недоступна".
# PublicIPLookupEnabled вимкнено за замовчуванням (аудит P1.10): запит до
# api.ipify.org/checkip.amazonaws.com — зайва зовнішня залежність, яка
# розкриває стороннім сервісам факт і час запуску backup. Увімкніть
# усвідомлено, якщо публічна IP-адреса потрібна в сповіщеннях.
$global:hostInformationSettings = @{
    PublicIPLookupEnabled = $false
    PublicIPLookupUrls = @(
        "https://api.ipify.org",
        "https://checkip.amazonaws.com"
    )
    PublicIPLookupTimeoutSeconds = 5
}

# ВИРОБНИЧІ КОРЕНІ ДАНИХ
#
# CODE != PRODUCTION DATA. Три незалежні поняття, які НЕ виводяться ані одне
# з одного, ані з розташування комплекту (RuntimeRoot):
#
#   LIMSRoot      — корінь production-інсталяції BRAVO (де лежить bravo.exe).
#                   "" = АВТОМАТИЧНО визначити через встановлену службу BRAVO
#                   (Name + DisplayName). Непорожнє = точний абсолютний шлях.
#   SystemLogRoot — каталог архівації СИСТЕМНИХ журналів BRAVO
#                   (Trace, exchangAPI, BravoWeb).
#                   "" = <EffectiveLIMSRoot>\ARCHIV\LOGS.
#                   Непорожнє = точний абсолютний шлях (без дописування ARCHIV\LOGS).
#   BackupRoot    — корінь локальних резервних копій
#                   (MODEL/BLOG/BRAVOEXCH/BAZA_APP/BAZA_WWW). Обов'язковий.
#
# Приклад розгортання на різних дисках:
#   LIMSRoot      = ""              (AUTO -> D:\LIMS-NEW зі служби BRAVO)
#   SystemLogRoot = ""             (AUTO -> D:\LIMS-NEW\ARCHIV\LOGS)
#   BackupRoot    = "E:\BRAVO_BACKUPS"
#
# Логи самих PowerShell-скриптів (BRAVO_ARCHIV/MAINTENANCE/HEALTH тощо)
# ТУТ НЕ налаштовуються. Вони ЗАВЖДИ пишуться в <RuntimeRoot>\LOGS, а
# helper-логи — у <RuntimeRoot>\LOGS\HELPERS.
#
# Машинний стан і operation lock теж не тут: %ProgramData%\BRAVO\State і
# %ProgramData%\BRAVO\Locks (не залежать від жодного з коренів вище).
#
# Мережеве сховище задавати UNC-шляхом (\\server\share\...), а НЕ буквою
# підключеного диска: заплановані завдання виконуються від
# NT AUTHORITY\SYSTEM, який не бачить дискових підключень користувача.
# Усі три "" — валідна all-AUTO конфігурація (значення за замовчуванням):
#   LIMSRoot      "" -> корінь встановлення канонічної служби BRAVO
#                       (батьківський каталог bravo.exe). Не знайдено /
#                       неоднозначно -> FAIL CLOSED (без filesystem-здогадок).
#   SystemLogRoot "" -> <EffectiveLIMSRoot>\ARCHIV\LOGS  (Trace/exchangAPI/BravoWeb)
#   BackupRoot    "" -> <EffectiveLIMSRoot>\ARCHIV       (MODEL/BLOG/BRAVOEXCH/
#                       BAZA_APP/BAZA_WWW)
# Непорожнє значення будь-якого кореня використовується ТОЧНО як абсолютний
# шлях. Мережеве сховище задавати UNC-шляхом (\\server\share\...), а не
# буквою підключеного диска (SYSTEM не бачить дискових підключень користувача).
# Диск явно заданого кореня має існувати на момент запуску: буква відсутнього
# диска (як-от порожній "Q:") завантажить конфіг без винятку, але завершиться
# керованою помилкою write-probe у dry-run.
#
# Приклади явного перевизначення (розкоментуйте й задайте свої значення):
#   LIMSRoot      = "D:\LIMS-NEW"
#   SystemLogRoot = "D:\LIMS-NEW\ARCHIV\LOGS"
#   BackupRoot    = "E:\BRAVO_BACKUPS"        # окремий диск під резервні копії
$global:pathSettings = @{
    LIMSRoot      = ""
    SystemLogRoot = ""
    BackupRoot    = ""
}

# =============================================
# НАЛАШТУВАННЯ BRAVO_MAINTENANCE
# =============================================

$global:maintenanceSettings = @{
    General = @{
        ObjectName = "$($bravoSettings.InstitutionName) [$($bravoSettings.InstitutionCode)]"
        ArchivePrefix = $bravoSettings.ArchivePrefix
        BravoWebDirectory = "C:\Br-a-vo.web"
    }
    Services = @{
        BravoName = "BRAVO"
        # Джерело істини для ідентифікації служби BRAVO (Discovery):
        # Service name ТА Display name одночасно. Не змінюйте це значення
        # окремо від фактичного Display name встановленої служби —
        # Resolve-BRAVOInstallationDiscovery вимагає збігу обох.
        BravoDisplayName = "BRAVO Service"
        # BRAVO_ARCHIV лише читає стан служб для журналу та сповіщень.
        # Зупиняти й запускати служби дозволено тільки BRAVO_MAINTENANCE.
        BravoWebEnabled = $true
        BravoWebCandidates = @(
            "BRAVOWeb",
            "BRAVO Web",
            "Br-a-vo.web",
            "Apache2.4",
            "Apache24",
            "Apache"
        )
        ExchangeApiName = "exchangAPI"
        # Служби BRAVO можуть довго виконувати init-процедури. Скрипт не показує
        # проміжні помилки Start-Service/Stop-Service, а очікує фактичний стан.
        StartTimeoutSeconds = 180
        StopTimeoutSeconds = 120
        PollIntervalSeconds = 2
    }
    Restore = @{
        Day = 7
        Time = "03:00"
        # Безпечне вікно, у яке дозволено ПОЧИНАТИ автоматичну реставрацію.
        # Реставрація зупиняє служби BRAVO і монопольно тримає модель, тому
        # поза цим вікном автоматичний запуск заборонено — зокрема
        # boot-recovery пропущеного слоту, який інакше стартував би вранці
        # після вмикання сервера. Вікно може перетинати північ.
        # -ForceRestore вікном НЕ обмежується: це свідома дія оператора,
        # яка лише пишеться в журнал як позапланова.
        WindowStart = "21:00"
        WindowEnd = "03:00"
        ArchivesKeepCount = 1
        # Профіль підхоплення ПРОПУЩЕНОЇ планової реставрації. Пропущений
        # слот на 24/7-сервері підхоплює щонічне Maintenance-завдання
        # (23:55, у межах вікна вище) — окремого шляху йому не потрібно.
        #
        #   "None"         — 24/7-сервер (default): Recovery-завдання не
        #                    реєструється взагалі; пропущена реставрація
        #                    виконається під час наступного планового
        #                    Maintenance у вікні WindowStart-WindowEnd.
        #   "HoldServices" — сервер РОБОЧОГО ЧАСУ (вимикається ввечері,
        #                    нічного вікна ніколи не бачить): пропущена
        #                    реставрація виконується ОДРАЗУ ПІСЛЯ СТАРТУ
        #                    сервера, ПОЗА вікном. Служби BRAVO/exchangAPI
        #                    переводяться інсталятором Планувальника на
        #                    Automatic (Delayed Start), а Recovery-завдання
        #                    (boot-trigger, delay 0) стартує раніше за них,
        #                    тримає служби зупиненими до завершення
        #                    реставрації і потім запускає — клієнти не
        #                    встигають зайти в програму до заміни моделі.
        #                    Fail-open: якщо Recovery-завдання не
        #                    відпрацювало, служби стартують самі (delayed
        #                    auto) — доступність LIMS важливіша за
        #                    реставрацію, спроба повториться наступним
        #                    стартом сервера. Перезавантаження серед
        #                    робочого дня з pending-реставрацією дасть
        #                    ~+10 хв простою одразу після нього — свідома
        #                    поведінка (клієнтів і так від'єднало
        #                    перезавантаженням).
        # -ForceRestore профілем не обмежується (свідома дія оператора).
        BootRestoreMode = "None"
        # 0: recovery стартує одразу після boot, до відкладеного (delayed)
        # старту служб.
        StartupDelayMinutes = 0
    }
    Retention = @{
        # Вік каталогу-дати програмних журналів (LOGS\<компонент>\YYYY-MM-DD),
        # після якого він пакується в .mdz.
        ArchiveDays = 14
        # Вік службових журналів самого Maintenance у корені LOGS\.
        LogDays = 180
        # Явний вимикач автоматичного видалення стиснутих .mdz програмних
        # журналів за віком (включно з добовими Trace_YYYYMMDD.mdz — вони
        # відкладаються на SFTP, але локальна копія охороняється саме цим
        # прапорцем). $false (типово) — .mdz НІКОЛИ не видаляються
        # автоматично; $true — діє CompressedLogDays нижче. Віддалені
        # SFTP-копії ця політика не чіпає ніколи.
        CompressedLogDeletionEnabled = $false
        # Вік уже стиснутого .mdz програмних журналів, після якого архів
        # видаляється (лише при CompressedLogDeletionEnabled = $true). Це
        # ОКРЕМА політика від ArchiveDays: та визначає, коли пакувати, ця —
        # коли видаляти спаковане. Приклад: ArchiveDays = 14 і
        # CompressedLogDays = 180 означає "каталог-дата живе 2 тижні, потім
        # ще пів року у вигляді архіву".
        CompressedLogDays = 180
        FailedArchiveDays = 30 # Неповні/пошкоджені архіви зберігаються для діагностики обмежений час
    }
    Trace = @{
        # Другий trace-файл застосунку (BIS). Основний TraceSRV.out
        # резолвиться автоматично з bravo.ini [Debug] FILE (Discovery) і
        # тут не налаштовується. Для TraceBIS.out надійного автоматичного
        # джерела немає, тому шлях задається ЯВНО. Порожньо (типово) —
        # джерело BIS не налаштоване: Maintenance пропускає його з
        # INFO-повідомленням (не помилка). Непорожнє значення має бути
        # абсолютним шляхом до файлу, напр.: "D:\LIMS\TraceBIS.out".
        BISSourcePath = ""
    }
    Limits = @{
        MinimumFreeSpaceGB = 20
        # Перевіряються всі локальні диски типу Fixed. Недоступний диск
        # вважається помилкою, якщо його явно не додано до виключень.
        # Формати виключень: "D:", "E", "F:\". За замовчуванням виключень немає.
        ExcludedDrives = @("F:\")
        MaximumMdFileSizeGB = 1.5
        MdFileSizeExclusions = @("KZPpatArc.md")
    }
    Automation = @{
        AutoShutdown = "off"
        ShutdownTimeoutSeconds = 60
        ArchiveAfterMaintenance = "off"
    }
    RangeIdMonitoring = @{
        Enabled = $true
        ThresholdPercent = 80
        CheckDelaySeconds = 2
    }
    # Параметри 7-Zip лише для BRAVO_MAINTENANCE.ps1:
    # архівація старих Trace/WebLogs і контрольних копій MODEL
    # до та після операцій відновлення.
    Archiver = @{
        CommandTimeoutSeconds = 14400
        IntegrityTestTimeoutSeconds = 14400
        Parameters = @(
            "a",
            "-mmt4",
            "-mx5",
            "-r",
            "-y",
            "-ssw",
            "-bb0",
            "-scrcSHA512",
            "-aoa"
        )
    }
    FileOperations = @{
        MoveRetryCount = 3
        MoveRetryDelaySeconds = 5
    }
    Logging = @{
        Level = "INFO"
    }
}

# =============================================
# ОСНОВНІ НАЛАШТУВАННЯ
# =============================================

# КОМПОНЕНТИ АРХІВАЦІЇ ТА СИНХРОНІЗАЦІЇ
# Для вимкнення компонента змініть $true на $false.
$global:componentSettings = @{
    Archive = @{
        MODEL = $true
        BLOG = $true
        BRAVOEXCH = $true
    }
    Synchronization = @{
        # Рівно чотири незалежні прапорці — інших значень для BAZA немає:
        # BAZA_APP_* — <BRAVO_ROOT>\BAZA; BAZA_WWW_* — {DocumentRoot}\BAZA
        # встановленого Apache/Br-a-vo.web. _LOCAL — копія в локальний
        # каталог під BackupRoot; _SFTP — синхронізація в хмару.
        # Локальна та хмарна перевірки в BRAVO_ARCHIV_HEALTH незалежні.
        BAZA_APP_LOCAL = $false
        BAZA_APP_SFTP = $true
        # Br-a-vo.web\www\BAZA -> SFTP /baza_www.
        # За замовчуванням ВИМКНЕНО ($false): джерело визначається через
        # зареєстровану службу Br-a-vo.web/Apache (стан служби — Running/
        # Stopped/Disabled — не впливає, лише сам факт реєстрації з
        # виконуваним файлом; safety-review) або через явний
        # discoverySettings.Sources.BAZA_WWW override — САМЕ ВІН, а не
        # WebRoot: discoverySettings.WebRoot сам по собі задає лише поле
        # WEB_ROOT (діагностика/похідні обчислення) і БЕЗ зареєстрованої
        # служби httpd.conf НЕ шукає — Sources.BAZA_WWW самостійно визначає
        # джерело, WebRoot самого по собі для цього недостатньо (детальніше
        # — OPERATIONS.md, "Стан служб не визначає політику backup"). На
        # серверах без BRAVO Web і без Sources.BAZA_WWW override увімкнений
        # прапорець дав би заплановане завдання з невизначеним джерелом.
        # Вмикайте його свідомо на розгортаннях, де BAZA WWW справді
        # синхронізується.
        BAZA_WWW_SFTP = $false
        # За замовчуванням вимкнено — на відміну від BAZA_APP_LOCAL, локальна
        # копія BAZA WWW ще не була потрібна жодному розгортанню.
        BAZA_WWW_LOCAL = $false
    }
    SFTP = @{
        ArchiveUpload = $true
    }
    SMB = @{
        ArchiveCopy = $false # За замовчуванням копіювання на NAS/SMB вимкнено
    }
}

# ЗАХИСТ СИНХРОНІЗАЦІЇ BAZA ТА BAZA WWW
# Хмара є накопичувальною: файли, видалені локально, мають залишатися на SFTP.
# Опція WinSCP -delete для BAZA заборонена перевірками конфігурації.
# Порожній локальний каталог додатково блокується як ознака проблеми джерела.
$global:synchronizationSafety = @{
    RequireNonEmptyBAZASource = $true
}

# ЗАПУСК ВІД ІМЕНІ АДМІНІСТРАТОРА
$global:requireAdministrator = $true
$global:elevationSettings = @{
    PowerShellExecutable = "powershell.exe"
    ArgumentsTemplate = '-NoProfile -ExecutionPolicy Bypass -File "{0}" -ConfigPath "{1}"'
    Verb = "runas"
    WindowStyle = "Normal"
}

# КОНСОЛЬ
$global:consoleSettings = @{
    # UTF-8 усуває змішування OEM 866 та Windows-1251 у старих консолях.
    OutputEncodingCodePage = 65001
    WindowTitleTemplate = "СКРИПТ АРХIВАЦIЇ LIMS v.{0}"
    BackgroundColor = "Black"
    ForegroundColor = "White"
    ClearOnStart = $true
    ShowTimestampsInConsole = $false # Дата й час залишаються у файлах логів
    PauseOnExit = $true               # Очікувати клавішу після ручного запуску
    PausePrompt = "Натиснiть будь-яку клавiшу для закриття вiкна..."

    # Рівні консолі та журналу незалежні: оператор бачить короткий статус,
    # а повна технічна хронологія залишається у файлі.
    # Можливі значення: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, FATAL.
    # На відміну від застарілого $logLevels, тут SUCCESS нижче за WARNING,
    # тому підняття порога ніколи не приховає попереджень і помилок.
    # Етапи й підсумок малює BRAVO.Console незалежно від рівня журналу, тому
    # SUCCESS-записи в консолі лише дублювали б рядок етапу технічними
    # деталями (GUID VSS-знімків, повні шляхи архівів і хешів).
    # У консоль потрапляє те, що потребує уваги; решта — у журналі.
    ConsoleLevel = "WARNING"  # Попередження й помилки; етапи та підсумок окремо
    FileLevel = "INFO"        # DEBUG/TRACE вмикаються для глибокої діагностики
    StepWidth = 58            # Ширина колонки з крапками перед статусом етапу
}

# ВІДОБРАЖЕННЯ ПРОГРЕСУ
$global:progressSettings = @{
    Enabled = $true                    # Головний перемикач усієї індикації
    ShowOverallProgress = $true        # Загальний етап і відсоток виконання скрипта
    ShowSevenZipOutput = $true         # Живий прогрес створення архіву
    ShowRobocopyOutput = $true         # Індикатор виконання локальної синхронізації BAZA
    ShowWinSCPOutput = $true           # Власний індикатор передачі на SFTP без дублювання виводу
    SevenZipProgressSwitch = ""        # Залишено для сумісності; використовується власний індикатор
    SevenZipTimeoutSeconds = 14400     # Максимум 4 години на створення одного архіву; 0 = без обмеження
    SevenZipTestTimeoutSeconds = 14400 # Максимум 4 години на повну перевірку архіву командою 7z t
    RobocopyProgressOptions = @("/ETA") # Показувати орієнтовний час завершення
    Activity = "BRAVO_ARCHIV — резервне копіювання"
}

# ЛОГУВАННЯ
$global:LogLevel = "INFO"  # Можливі значення: "DEBUG", "INFO", "WARNING", "ERROR", "SUCCESS"
$global:defaultLogLevel = "INFO"
$global:logLevels = @{
    DEBUG = 0
    INFO = 1
    WARNING = 2
    ERROR = 3
    SUCCESS = 4
}
$global:logSeparatorLength = 100
$global:logTimestampFormat = "yyyy-MM-dd HH:mm:ss"
$global:durationFormat = "hh\:mm\:ss"
$global:logFileDateFormat = "yyyyMMdd_HHmmss"
$global:logFileNameTemplate = "BRAVO_ARCHIV_{0}_PID{1}.log"
$global:logFileFilter = "BRAVO_ARCHIV_*.log"
$global:logFileEncoding = "UTF8"
$global:logColors = @{
    Default = "White"
    Header = "Yellow"
    SUCCESS = "Green"
    ERROR = "Red"
    WARNING = "Yellow"
    DEBUG = "Gray"
    Progress = "Cyan"
}

# НАЛАШТУВАННЯ АРХІВАЦІЇ
$global:archivePrefix = $bravoSettings.ArchivePrefix
$global:logRetentionDays = 31
$global:archiveRetentionDays = 183 # Коректні архіви зберігаються не менше 6 календарних місяців
$global:enableArchiveDeletion = $false  #параметр: true/false видалення старих архівів
# Скільки останніх (за часом) перевірених (SHA512 збігається) комплектів
# кожного компонента ніколи не видаляти незалежно від archiveRetentionDays —
# навіть якщо серія невдалих backup залишила лише старі перевірені копії.
# 2, а не 1: одна єдина захищена копія не дає запасу, якщо саме вона
# виявиться пошкодженою між перевіркою й фактичним відновленням.
$global:minimumRetainedVerifiedBackups = 2
$global:failedArchiveRetentionDays = 30 # Термін зберігання неповних/пошкоджених комплектів
$global:enableFailedArchiveDeletion = $true # Окреме очищення лише непридатних комплектів після терміну
# Прибирання осиротілих тимчасових артефактів (.work\*.partial*), що
# лишаються, коли процес перервано (втрата живлення, force-kill, крах) між
# створенням тимчасового файлу і Remove-BRAVOTemporaryArchiveArtifacts.
# .partial-файл ніколи не є опублікованим backup (перейменування у фінальне
# ім'я — останній, атомарний крок), тому видалення безпечне за конструкцією.
# Enter-BRAVOArchiveProcessLock (ексклюзивний, спільний з Maintenance,
# тримається увесь прогін) вже виключає паралельний другий Archive/
# Maintenance на цій машині — поріг нижче лише додатковий запобіжник,
# свідомо суттєво більший за ExecutionTimeLimitHours Scheduler.Backup (30 год).
$global:enableOrphanTempCleanup = $true
$global:orphanTempRetentionHours = 48
# Очищення обідніх архівів (_1300.) у зовнішньому сховищі. Не залежить від
# enableArchiveDeletion, щоб за потреби зберігати звичайні архіви безстроково.
$global:enableLunchArchiveCleanup = $false
$global:lunchArchiveCleanupPath = "E:\Archiv"
$global:lunchArchiveCleanupDirectories = @("MODEL", "BLOG", "BRAVOEXCH")
$global:lunchArchiveRetentionMonths = 2
# Секунди обов'язкові: GenerationId має однозначно ідентифікувати запуск.
# З точністю до хвилини два запуски в межах однієї хвилини (ручний після
# автоматичного, повтор після збою) давали б однакове ім'я — тобто збіг із
# уже наявним валідним backup там, де його бути не повинно.
$global:archiveTimestampFormat = "yyyyMMdd_HHmmss"
$global:archiveFileFilter = "*.mdz"
$global:hashFileFilter = "*.sha512"
$global:hashFileExtension = ".sha512"
$global:hashFileEncoding = "utf-8"

# ПАРАМЕТРИ BRAVO_ARCHIV.ps1
# Використовуються лише для щоденних резервних копій MODEL, BLOG і BRAVOEXCH.
# Не пов'язані з maintenanceSettings.Archiver.Parameters вище.
$global:archiveParams = "a -mmt -mx6 -r -y -ssw -scrcSHA512 -bb0 -aoa"

# УЗГОДЖЕНІСТЬ ЩОДЕННИХ РЕЗЕРВНИХ КОПІЙ
# MODEL/BLOG/BRAVOEXCH однієї generation читаються з одного VSS Snapshot Set.
# Однакові томи дедуплікуються; якщо VSS недоступний, архів не створюється
# з live-каталогу і запуск завершується з помилкою.
$global:backupConsistency = @{
    Mode = "VSS"
    SnapshotContext = "ClientAccessible"
}

# Спільна machine-wide координація BRAVO_ARCHIV і BRAVO_MAINTENANCE.
# Активність визначає exclusive handle, а не сам факт існування файла:
# файл навмисно лишається після запуску як остання діагностична metadata.
$programDataRoot = if ([string]::IsNullOrWhiteSpace($env:ProgramData)) {
    'C:\ProgramData'
} else {
    [Environment]::ExpandEnvironmentVariables($env:ProgramData)
}
$global:operationLockSettings = @{
    Path = Join-Path $programDataRoot 'BRAVO\Locks\BRAVO_OPERATION.lock'
}

# НАЛАШТУВАННЯ ROBOCOPY
$global:robocopyPath = "robocopy.exe"
$global:robocopyOptions = @(
    "/E",    # Включаючи підпапки
    "/R:3",  # 3 повторні спроби
    "/W:5",  # 5 секунд очікування
    "/TBD",  # Чекати на мережеві диски
    "/NP",   # Не показувати відсотки
    "/MT:8"  # 8 потоків
)
$global:robocopyMaxSuccessExitCode = 7
$global:robocopyWindowStyle = "Hidden"

# =============================================
# НАЛАШТУВАННЯ SFTP
# =============================================

# {0} автоматично замінюється значенням BRAVO_SFTP_LOGIN із Credential Manager.
# Наприклад: BRAVO_SFTP_LOGIN = u123456-sub1 -> u123456-sub1.your-storagebox.de
$global:sftpHostTemplate = "{0}.your-storagebox.de"
$global:sftpPort = 22
$global:sftpHostKey = "`"ssh-rsa 2048 3d:7b:6f:99:5f:68:53:21:73:15:f9:2e:6b:3a:9f:e3`""
$global:sftpConnectionTimeoutSeconds = 30
$global:winSCPScriptEncoding = "ASCII"
$global:winSCPIniPath = "nul"
# УВАГА: не додавати -delete. Віддалені файли BAZA, яких уже немає локально,
# зберігаються у хмарі для подальшого відновлення.
$global:sftpSynchronizationOptions = "-mirror -criteria=time,size -transfer=binary -resumesupport=on"

# =============================================
# НАЛАШТУВАННЯ NAS/SMB
# =============================================
# Перед увімкненням componentSettings.SMB.ArchiveCopy задайте UNC-шлях до
# каталогу на NAS, наприклад: \\192.168.1.10\backup\BRAVO
$global:smbSettings = @{
    RootPath = "\\NAS-SERVER\BRAVO_BACKUP"
    Directories = @{
        MODEL = "model"
        BLOG = "blog"
        BRAVOEXCH = "bravoexch"
    }
    CopyBufferSizeMB = 4
}

# =============================================
# ШЛЯХИ ДО ДЖЕРЕЛ ДАНИХ
# =============================================

# Шляхи беруться зі спільної секції pathSettings.
#
# $global:scriptPath — застарілий псевдонім RuntimeRoot (каталог КОМПЛЕКТУ, де
# лежать BRAVO_ARCHIV.ps1/BRAVO_MAINTENANCE.ps1/BRAVO_HEALTH.ps1). РАНІШЕ він
# дорівнював ConfigRoot; коли RuntimeRoot і ConfigRoot збігалися, різниці не
# було. У новій архітектурі config може лежати окремо (-ConfigPath), тому
# скрипти-завдання, що будуються нижче, мусять братися з RuntimeRoot, а не з
# каталогу конфігурації — інакше заплановані завдання вказували б на файли
# поруч із config, яких у комплекті немає.
$global:scriptPath = $global:runtimeRoot

# EffectiveLIMSRoot: explicit pathSettings.LIMSRoot або AUTO через канонічну
# службу BRAVO (Name + DisplayName). Кілька служб з різними виконуваними
# файлами — і далі кероване падіння (fail-closed): технічно валідний backup
# НЕ ТІЄЇ інсталяції гірший за помилку.
#
# Відсутність самої служби при LIMSRoot="" БІЛЬШЕ НЕ throw тут (safety-review
# "service state != backup policy"): LIMSRoot функціонально потрібен лише
# BRAVO_MAINTENANCE (реальне керування службою/restore, SystemLogRoot/
# TRACE_FILE) і AUTO-режиму SystemLogRoot/BackupRoot нижче. BRAVO_ARCHIV не
# ВИМАГАЄ LIMSRoot (не залежить від нього як від prerequisite) — MODEL/
# BLOG/BRAVOEXCH походять з bravo.ini (Resolve-BRAVOInstallationDiscovery,
# її параметр -LimsRoot ніде не використовується в тілі функції), а
# BackupRoot/BAZA_APP/BAZA_WWW мають власні незалежні джерела істини. Сам
# `$rootPath` (=EffectiveLIMSRoot) технічно ЧИТАЄТЬСЯ в Archive.Runtime.ps1
# (інформаційний рядок логу; fallback-джерело для sanity-перевірки
# free-space preflight, коли він порожній) — просто ніде не є умовою, від
# якої залежить результат backup. BRAVO_HEALTH — read-only, LIMSRoot
# взагалі не читає (лише BackupRoot). Тому єдиний сценарій, де відсутність
# служби BRAVO мала б зупиняти запуск, — це BRAVO_MAINTENANCE, і там є власна явна
# перевірка одразу після Import-BravoConfiguration (`$effectiveLimsRoot`
# непорожній -> інакше exit 30) — throw тут дублював би її для ВСІХ
# entrypoint-ів одразу, включно з тими двома, кому LIMSRoot не потрібен.
$global:limsRootResult = Resolve-BRAVOEffectiveLimsRoot `
    -ConfiguredPath ([string]$pathSettings.LIMSRoot) `
    -BravoServiceName ([string]$maintenanceSettings.Services.BravoName) `
    -BravoDisplayName ([string]$maintenanceSettings.Services.BravoDisplayName)
$global:effectiveLimsRoot = [string]$limsRootResult.EffectivePath
$global:LIMS_PATH = $global:effectiveLimsRoot
$global:rootPath = $global:effectiveLimsRoot

# =============================================
# АВТОМАТИЧНИЙ DISCOVERY ДЖЕРЕЛ (MODEL/BLOG/BRAVOEXCH/BAZA_APP/BAZA_WWW/BACKUP_ROOT)
# =============================================
# CLAUDE_CODE_TZ_ARCHIV_LIMS_MONOLITH.md. За замовчуванням усе визначається
# автоматично:
#   - служба BRAVO ідентифікується за Service name ТА Display name
#     одночасно (maintenanceSettings.Services.BravoName/BravoDisplayName);
#   - bravo.ini шукається в системному каталозі Windows
#     (%SystemRoot%\SysWOW64 на 64-бітній, \System32 на 32-бітній) —
#     не поруч із bravo.exe;
#   - BackupRoot: явне pathSettings.BackupRoot або AUTO ->
#     <EffectiveLIMSRoot>\ARCHIV (резолвер Resolve-BRAVOEffectiveBackupRoot,
#     нижче), не з Discovery джерел MODEL/BLOG/BRAVOEXCH.
# Будь-яке значення нижче, явно задане (не $null), перемагає над
# автоматично знайденим і НІКОЛИ не замінюється мовчки.
$global:discoverySettings = @{
    BravoIniPath = $null
    BravoRoot = $null
    WebRoot = $null
    Sources = @{
        MODEL = $null
        BLOG = $null
        BRAVOEXCH = $null
        BAZA_APP = $null
        BAZA_WWW = $null
        BACKUP_ROOT = $null
    }
}
$global:bravoDiscoveryResult = Resolve-BRAVOInstallationDiscovery `
    -LimsRoot $rootPath `
    -DiscoverySettings $discoverySettings `
    -BravoServiceName ([string]$maintenanceSettings.Services.BravoName) `
    -BravoDisplayName ([string]$maintenanceSettings.Services.BravoDisplayName) `
    -WebServiceCandidates @($maintenanceSettings.Services.BravoWebCandidates) `
    -ExchangeApiServiceName ([string]$maintenanceSettings.Services.ExchangeApiName)

# BackupRoot НЕ береться з Discovery джерел (MODEL/BLOG/BRAVOEXCH). Його
# ефективне значення обчислює Resolve-BRAVOEffectiveBackupRoot нижче: явний
# pathSettings.BackupRoot використовується точно, а "" дає детермінований
# AUTO <EffectiveLIMSRoot>\ARCHIV. Мовчазної заміни явного значення немає —
# те, що видно в конфігурації, і є тим, що використовується.

# ДЖЕРЕЛА ДАНИХ ДЛЯ АРХІВАЦІЇ
# MODEL/BLOG/BRAVOEXCH беруться лише з explicit override або canonical
# bravo.ini. Евристики на кшталт LIMSRoot\Model чи C:\bravoexch тут
# небезпечні: за кількох інсталяцій вони можуть створити коректний архів
# неправильних даних.
$global:bravoExchSourceCandidates = @(
    [string]$bravoDiscoveryResult.BRAVOEXCH_SOURCE |
        Where-Object { -not [string]::IsNullOrWhiteSpace($_) }
)
$global:bravoExchSourceDirectory = $null
foreach ($candidateDirectory in $bravoExchSourceCandidates) {
    if (-not (Test-Path -LiteralPath $candidateDirectory -PathType Container)) {
        continue
    }
    # BEXCH is a queue tree and can legitimately contain only empty
    # directories between exchanges. The canonical bravo.ini path plus an
    # existing directory is sufficient identity; requiring a current file
    # would disable backups exactly while the queue is idle.
    $global:bravoExchSourceDirectory = $candidateDirectory
    break
}
$bravoExchArchiveSource = if (
    -not [string]::IsNullOrWhiteSpace($bravoExchSourceDirectory)
) {
    Join-Path $bravoExchSourceDirectory "*"
} else {
    $null
}

# Джерело істини — Resolve-BRAVOInstallationDiscovery (BAZA_WWW уже
# обчислено вище): служба Apache2.4/Br-a-vo.web -> httpd.conf ->
# DocumentRoot -> {DocumentRoot}\BAZA. Об'єкт нижче лише адаптує поля
# discovery до форми, яку вже читають Archive/Health (Success/Source/
# ServiceName/ServiceDisplayName/ServiceExecutable/Reason) — самої
# логіки пошуку тут більше немає.
# Виявлення потрібне, якщо ввімкнено БУДЬ-ЯКИЙ з двох незалежних
# способів синхронізації BAZA WWW (SFTP або локальна копія) — обидва
# читають те саме джерело.
$global:bazaWWWDetection = if (-not (
        [bool]$componentSettings.Synchronization.BAZA_WWW_SFTP -or
        [bool]$componentSettings.Synchronization.BAZA_WWW_LOCAL
    )) {
    [pscustomobject]@{
        Success = $false
        Source = $null
        ServiceName = $null
        ServiceDisplayName = $null
        ServiceExecutable = $null
        Reason = "синхронізацію BAZA WWW вимкнено в конфігурації"
    }
} elseif (-not [string]::IsNullOrWhiteSpace([string]$bravoDiscoveryResult.BAZA_WWW)) {
    [pscustomobject]@{
        Success = $true
        Source = [string]$bravoDiscoveryResult.BAZA_WWW
        ServiceName = [string]$bravoDiscoveryResult.WebServiceName
        ServiceDisplayName = [string]$bravoDiscoveryResult.WebServiceDisplayName
        ServiceExecutable = [string]$bravoDiscoveryResult.WebServiceExecutable
        Reason = $null
    }
} else {
    [pscustomobject]@{
        Success = $false
        Source = $null
        ServiceName = $null
        ServiceDisplayName = $null
        ServiceExecutable = $null
        Reason = [string]$bravoDiscoveryResult.Reasons.BAZA_WWW
    }
}

$global:sourcePaths = @{
    Model = $(if ([string]::IsNullOrWhiteSpace([string]$bravoDiscoveryResult.MODEL_SOURCE)) { $null } else { Join-Path ([string]$bravoDiscoveryResult.MODEL_SOURCE) "*" })
    Blog = $(if ([string]::IsNullOrWhiteSpace([string]$bravoDiscoveryResult.BLOG_SOURCE)) { $null } else { Join-Path ([string]$bravoDiscoveryResult.BLOG_SOURCE) "*" })
    BravoExch = $bravoExchArchiveSource
}

# =============================================
# КАТАЛОГИ ПРИЗНАЧЕННЯ
# =============================================

# EffectiveBackupRoot: корінь резервних копій (MODEL/BLOG/BRAVOEXCH/BAZA_APP/
# BAZA_WWW). explicit pathSettings.BackupRoot або AUTO -> <EffectiveLIMSRoot>\
# ARCHIV. [IO.Path]::Combine (усередині резолвера), а не Join-Path: диск кореня
# може бути ще не змонтований під час завантаження — доступність перевіряє
# write-probe у dry-run, а не завантаження конфігурації.
$global:backupRootResult = Resolve-BRAVOEffectiveBackupRoot `
    -ConfiguredPath ([string]$pathSettings.BackupRoot) `
    -EffectiveLimsRoot $global:effectiveLimsRoot
if ([string]$backupRootResult.Source -eq 'Error' -or
    [string]::IsNullOrWhiteSpace([string]$backupRootResult.EffectivePath)) {
    throw "Не вдалося визначити BackupRoot: $($backupRootResult.Reason)"
}
$global:backupRootPath = [string]$backupRootResult.EffectivePath

# EffectiveSystemLogRoot: системні журнали BRAVO (Trace/exchangAPI/BravoWeb)
# — зона BRAVO_MAINTENANCE; BRAVO_ARCHIV і BRAVO_HEALTH його не читають
# (перевірено: жодного посилання на $systemLogRoot поза
# BRAVO.Maintenance.Runtime.ps1). Той самий принцип, що LIMSRoot вище: не
# throw тут — Maintenance має власну явну перевірку одразу після
# Import-BravoConfiguration.
$global:systemLogRootResult = Resolve-BRAVOEffectiveSystemLogRoot `
    -ConfiguredPath ([string]$pathSettings.SystemLogRoot) `
    -EffectiveLimsRoot $global:effectiveLimsRoot
$global:systemLogRoot = [string]$systemLogRootResult.EffectivePath

# RuntimeLogRoot — журнали САМИХ PowerShell-скриптів. ЗАВЖДИ <RuntimeRoot>\LOGS,
# незалежно від LIMSRoot/SystemLogRoot/BackupRoot. $logPath лишається як
# псевдонім рівно з цим одним значенням (script logs), щоб наявні споживачі
# не плуталися між типами журналів (ТЗ: один $logPath = один сенс).
$global:runtimeLogRoot = Join-Path $runtimeRoot "LOGS"
$global:logPath = $global:runtimeLogRoot

# Машинний стан — поруч з operation lock у %ProgramData%\BRAVO\State, а не в
# каталозі логів: стан не є журналом і не підлягає log-retention.
$global:stateRoot = Join-Path $programDataRoot 'BRAVO\State'

# Tools\ — це runtime-залежності комплекту (виконувані файли під захистом
# маніфесту), а не дані бекапу. Вони лежать поруч зі скриптами (RuntimeRoot).
$global:toolsPath = Join-Path $runtimeRoot "Tools"
$global:arcPath = Join-Path $toolsPath "7za.exe"
$global:winSCPPath = Join-Path $toolsPath "WinSCP.com"
$global:winSCPAssemblyPath = Join-Path $toolsPath "WinSCPnet.dll"

# ЦІЛІСНІСТЬ ІНСТРУМЕНТІВ (7za.exe, WinSCP.*)
#
# Заплановані завдання виконуються від NT AUTHORITY\SYSTEM, тому
# підмінений 7za.exe або WinSCP.com отримав би найвищі права в системі.
# Еталонні SHA-256 зберігаються у version-controlled TOOLS_MANIFEST.json
# (потрапляє на сервер разом з комплектом і проходить код-рев'ю).
#
#   Enforce — розбіжність блокує запуск (код завершення 32), надсилається
#             критичне сповіщення. Значення за замовчуванням.
#   Warn    — лише попередження в лозі; запуск продовжується. Тимчасовий
#             режим для міграції, не для постійної експлуатації.
#
# Маніфест НІКОЛИ не створюється й не оновлюється автоматично на сервері:
# інакше зловмисник, який має права підмінити інструмент, тим самим
# доступом перепише й еталон.
$global:toolIntegritySettings = @{
    Mode = "Enforce"
    # Еталонний маніфест лежить у тому самому каталозі, що й самі
    # інструменти (Tools\), а не поруч зі скриптом — так само, як
    # TOOLS_INTEGRITY.json (TOFU-базова лінія) нижче.
    ManifestPath = Join-Path $toolsPath "TOOLS_MANIFEST.json"
}

# ЛОКАЛЬНІ КАТАЛОГИ ДЛЯ ЗБЕРІГАННЯ АРХІВІВ
# За потреби окремий компонент можна спрямувати в інший каталог, замінивши
# Join-Path на абсолютний шлях, наприклад:
# Model = "E:\BRAVO_BACKUPS\MODEL"
# [IO.Path]::Combine замість Join-Path: Join-Path кидає DriveNotFoundException,
# якщо диск кореня ще не існує на цій машині (наприклад BackupRoot на E:, якого
# на сервері немає). Композиція шляхів не повинна валитися на етапі
# завантаження конфігурації — доступність кореня перевіряє write-probe
# (BRAVO_DRY_RUN / preflight у BRAVO_ARCHIV), який дає зрозумілу діагностику.
$global:archiveDirs = @{
    Model = [System.IO.Path]::Combine($backupRootPath, "MODEL")
    Blog = [System.IO.Path]::Combine($backupRootPath, "BLOG")
    BravoExch = [System.IO.Path]::Combine($backupRootPath, "BRAVOEXCH")
}

# ШЛЯХИ ДЛЯ СИНХРОНІЗАЦІЇ BAZA_APP І BAZA_WWW
# BAZA_APP визначається лише з explicit override, canonical bravo.ini або
# каталогу підтвердженої служби BRAVO. Відсутність усіх джерел є керованою
# помилкою, а не приводом підставляти LIMSRoot. Destination потрібен лише
# для BAZA_APP_LOCAL.
$global:bazaAppPaths = @{
    Source = [string]$bravoDiscoveryResult.BAZA_APP
    Destination = [System.IO.Path]::Combine($backupRootPath, "BAZA_APP")
}
# Destination тут потрібен лише для BAZA_WWW_LOCAL (SFTP не використовує
# локальний проміжний каталог — WinSCP синхронізує Source напряму).
$global:bazaWWWPaths = @{
    Source = [string]$bazaWWWDetection.Source
    Destination = [System.IO.Path]::Combine($backupRootPath, "BAZA_WWW")
}

# =============================================
# КАТАЛОГИ ЗБЕРІГАННЯ НА SFTP
# Усі значення змінюються через цей блок без редагування .ps1.
# Дозволено також вкладені шляхи, наприклад: "backups/baza_www".
# Віддалені каталоги потрібно попередньо створити на SFTP.
# =============================================

$global:sftpDirectories = @{
    MODEL = "model"          # Архіви MODEL і .sha512
    Blog = "blog"            # Архіви BLOG і .sha512
    BravoExch = "bravoexch"  # Архіви BRAVOEXCH і .sha512
    BAZA = "baza_app"        # Основна BAZA
    BAZAWWW = "baza_www"     # Br-a-vo.web\www\BAZA
    Manifest = "manifests"   # BRAVO_BACKUP_<GenerationId>.json
    Trace = "trace"          # Добові Trace_YYYYMMDD.mdz і .sha512 (Maintenance)
}

# =============================================
# ЕФЕКТИВНА КОНФІГУРАЦІЯ СИНХРОНІЗАЦІЇ BAZA — ЄДИНЕ ДЖЕРЕЛО ПРАВДИ
# =============================================
# Обчислюється ОДИН раз (Config Loader) і споживається Installer, Diagnose,
# Dry Run і production runtime через $global:bazaSyncEffective. Жоден скрипт не
# повторює бізнес-правила "чи потрібне BAZASync-завдання", "яке джерело
# обов'язкове" чи "який SFTP-каталог потрібен" самостійно.
$global:bazaSyncEffective = Get-BRAVOEffectiveSynchronizationConfiguration `
    -Synchronization $componentSettings.Synchronization `
    -BazaAppSource ([string]$bazaAppPaths.Source) `
    -BazaWWWSource ([string]$bazaWWWPaths.Source) `
    -BazaWWWDetection $bazaWWWDetection `
    -SftpDirectories $sftpDirectories

# БАЗОВІ ШЛЯХИ, ЯКІ ПЕРЕВІРЯЮТЬСЯ ЗАВЖДИ
$global:baseRequiredPaths = @(
    @{Path=$logPath; Description="Каталог логiв"; CreateIfMissing=$true}
)

# ОПИСИ АРХІВІВ
$global:archiveDefinitions = @(
    @{
        Type = "MODEL"
        Enabled = $componentSettings.Archive.MODEL
        NameTemplate = "{0}_{1}.mdz"
        Source = $sourcePaths.Model
        Destination = $archiveDirs.Model
    },
    @{
        Type = "BLOG"
        Enabled = $componentSettings.Archive.BLOG
        NameTemplate = "{0}_blog_{1}.mdz"
        Source = $sourcePaths.Blog
        Destination = $archiveDirs.Blog
    },
    @{
        Type = "BRAVOEXCH"
        Enabled = $componentSettings.Archive.BRAVOEXCH
        NameTemplate = "{0}_bravoexch_{1}.mdz"
        Source = $sourcePaths.BravoExch
        Destination = $archiveDirs.BravoExch
    }
)

# =============================================
# МОНІТОРИНГ ЛОКАЛЬНИХ І ВІДДАЛЕНИХ РЕЗЕРВНИХ КОПІЙ
# =============================================
# Health є окремою read-only утилітою та не містить код архівації.
# Єдиний дозволений виняток з read-only: watchdog аварійного відновлення
# служб — Health стартує РІВНО ті служби, які перелічені у власному
# осиротілому ownership-маркері BRAVO_SERVICE_QUIESCENCE.json (його пишуть
# Maintenance/DataRestore перед зупинкою служб; власник мертвий за
# pid+processStartTime). Ручні зупинки без маркера Health лише алертить.
$global:backupHealthScriptPath = Join-Path $runtimeRoot "BRAVO_HEALTH.ps1"
$global:backupMonitoring = @{
    Enabled = $true
    RunAfterBackup = $true
    # Поза активним backup/maintenance перевіряти встановлені й не Disabled
    # служби BRAVO, exchangAPI та BRAVO Web.
    CheckManagedServices = $true
    MaxBackupAgeHours = 24
    CandidateLimit = 10

    # Повна SHA512-перевірка великих архівів може тривати довго.
    # Якщо $false, перевіряється наявність і коректний формат hash-файлу.
    VerifyFileHash = $true

    # Незалежна read-only перевірка того, що фактично знаходиться на SFTP.
    # Виконується через BRAVO_HEALTH.ps1.
    SFTP = @{
        Enabled = $true
        CheckArchiveUploads = $true
        # Застосовується до увімкнених BAZA_APP_SFTP і BAZA_WWW_SFTP.
        CheckBAZASynchronization = $true
        VerifyRemoteArchiveHash = $true
        # $false: якщо SFTP-сервер забороняє checksum/shell, достатньо точного
        # збігу завантаженого віддаленого .sha512 з локальним sidecar.
        # $true: відсутність серверного SHA завжди вважається помилкою.
        RequireServerSideArchiveHash = $false
        RemoteBackupMaxAgeHours = 24
        # Таймаут коротких SFTP-операцій, завантаження окремого архіву та
        # read-only health-check.
        OperationTimeoutSeconds = 1800
        # Окремий таймаут повної синхронізації каталогів BAZA/BAZA WWW.
        # Велика первинна передача тисяч дрібних файлів може тривати години.
        SynchronizationTimeoutSeconds = 14400
        # Read-only порівняння BAZA: WinSCP .NET або
        # WinSCP.com synchronize remote -preview як fallback.
        # Віддалені файли, відсутні локально, навмисно ігноруються.
        # Сповіщення створюється, коли локального файла/папки немає у хмарі
        # або наявний віддалений файл потребує оновлення. Додаткові об'єкти,
        # які залишилися лише у хмарі, навмисно ігноруються.
        # Опція -delete тут заборонена.
        BAZAPreviewOptions = "-preview -mirror -criteria=time,size"
        DifferenceDetailLimit = 10
        # BAZA змінюється між плановими синхронізаціями. Черга молодша за цей
        # вік є нормальною й лише записується в health-log без alert.
        # Alert надсилається, коли найстаріша непередана зміна перевищить ліміт.
        BAZAPendingAlertAfterHours = 26

        # BAZA_APP/BAZA_WWW: append-only накопичувальний SFTP (>50 ГБ,
        # сотні тисяч файлів, файли ніколи не змінюються після передачі,
        # -delete на SFTP заборонено назавжди). BRAVO.BazaSync замінює
        # для цього workload повне порівняння дерева на кожному циклі
        # на incremental sync із persisted state — без цього BAZAPreviewOptions
        # вище й BAZAPendingAlertAfterHours лишаються legacy-шляхом.
        # ЦЕ НЕ Durable Operation Journal — стан лише для оптимізації/
        # надійності самої BAZA-синхронізації.
        BAZA = @{
            # "IncrementalAppendOnly": новий двигун (sync cycle/cutoff,
            # persisted state, fast Health без повного remote listing).
            # Будь-яке інше значення (напр. "Legacy") лишає повністю
            # незмінним старий шлях: WinSCP synchronize remote /
            # synchronize remote -preview на кожному циклі.
            Mode = "IncrementalAppendOnly"
            # Standalone BRAVO_HEALTH без свіжого SyncResult від Archive
            # спершу синхронізує BAZA і лише потім оцінює health —
            # НІКОЛИ "preview -> знайдено нові файли -> alert".
            SynchronizeBeforeHealth = $true
            # Fast Health: оцінка вже готового SyncResult (pendingWithinCutoff/
            # failed/checkpoint/freshness), без повного remote directory
            # listing на 50+ ГБ на кожному циклі.
            FastHealthEnabled = $true
            # Full Audit: періодичне повне порівняння локального й
            # віддаленого дерева (ловить дрейф, якого incremental-план
            # структурно не бачить — напр. хтось вручну видалив файл на
            # SFTP). НЕ виконується на кожному Archive/Health циклі.
            FullAuditEnabled = $true
            FullAuditEveryDays = 7
            # Мутація вже підтвердженого (Verified) файлу — розмір
            # локального файлу змінився після успішної передачі — це
            # порушення append-only інваріанту. "Fail": не перезаписувати
            # мовчки на SFTP, позначити помилку й вимагати свідомого
            # рішення оператора (інше значення поки не реалізоване).
            MutationPolicy = "Fail"
            # Опційний поріг авто-архівування append-only мутацій: 0
            # (типово) = вимкнено, MUTATION_VIOLATION блокує передачу й
            # вимагає ручного BRAVO_BAZA_RECONCILE.ps1, як і завжди. При N
            # > 0 — якщо мутацій за ОДИН цикл на компонент не більше N,
            # виконується та сама rename-preserve операція, що ручний
            # -AcceptAll (стара версія на SFTP -> *.replaced_<дата>,
            # НІЧОГО не видаляється), автоматично, БЕЗ підтвердження
            # оператора для кожного циклу — лише інформаційне Health-
            # повідомлення (не CRITICAL). Понад N за цикл — без змін:
            # жорсткий блок, CRITICAL, ручне рішення. Вмикайте свідомо:
            # це послаблює анти-ransomware circuit breaker (немає
            # додаткового сукупного добового/тижневого ліміту — лише
            # per-cycle поріг). Див. OPERATIONS.md, THREAT_MODEL.md.
            AutoArchiveMutationThreshold = 0
            # Корінь persisted-стану BAZA-синхронізації. Модуль сам додає
            # підкаталог "BAZA" і файл "<Component>.state.json"
            # (фактичний шлях: <StateRoot>\BAZA\BAZA_APP.state.json тощо).
            StateRoot = $stateRoot
        }
    }

    # Read-only перевірка копій архівів та hash-файлів на NAS/SMB.
    # Виконується лише коли componentSettings.SMB.ArchiveCopy = $true.
    SMB = @{
        Enabled = $true
        CheckArchiveCopies = $true
        VerifyRemoteArchiveHash = $true
        RemoteBackupMaxAgeHours = 24
    }

    # AUD-008 (аудит P1.6): sanity-check обсягу щойно створеного backup.
    # Технічно валідний архів (7za test + SHA512 збігається) все одно може
    # бути підозріло малим через неправильне джерело, зламані permissions
    # чи неповний VSS exposure. Порівнюється з медіаною останніх валідних
    # архівів того самого компонента — НЕ блокує backup, лише сигналізує
    # (WARNING у лозі й Slack/Discord-сповіщенні через лічильник попереджень).
    SizeSanity = @{
        Enabled = $true
        # Скільки останніх валідних (hash-підтверджених) архівів компонента
        # брати для медіани. Перші запуски компонента (історії ще немає)
        # автоматично пропускають перевірку, а не считаються аномалією.
        HistoryCount = 5
        # Абсолютний мінімум незалежно від історії — захищає навіть перший
        # backup компонента, коли порівнювати ще нема з чим.
        MinimumBytes = 1024
        # Падіння розміру відносно медіани історії, що вважається аномалією.
        MaxSizeDropPercent = 50
    }

    InstitutionName = $bravoSettings.InstitutionName
    InstitutionCode = $bravoSettings.InstitutionCode
    NotificationProvider = $bravoSettings.NotificationProvider
    NotificationMode = $bravoSettings.NotificationMode
    NotificationCredentialTargets = $credentialSettings.Targets
    NotificationRequestTimeoutSeconds = $bravoSettings.NotificationRequestTimeoutSeconds
    # Safe-default дублюється навмисно: BRAVO.config парситься до
    # гарантованого імпорту BRAVO.Notifications, тому не може покладатись
    # на дефолт усередині модуля — старий config без NotificationRouting
    # має лишатись валідним і поводитись так само (SUCCESS->general,
    # WARNING/ERROR/CRITICAL->alerts).
    NotificationRouting = if ($bravoSettings.Contains("NotificationRouting") -and
        $bravoSettings.NotificationRouting -is [hashtable]) {
        $bravoSettings.NotificationRouting
    } else {
        @{ SUCCESS = "general"; WARNING = "alerts"; ERROR = "alerts"; CRITICAL = "alerts" }
    }
    NotifyOnSuccessAfterBackup = $true

    # Повторювати однакове критичне повідомлення не частіше цього інтервалу.
    RepeatAlertAfterHours = 6
    AlertStatePath = Join-Path $stateRoot "BRAVO_ARCHIV_HEALTH_ALERT_STATE.json"
    LogFileNameTemplate = "BRAVO_ARCHIV_HEALTH_{0}.log"
}

# =============================================
# ПЛАНУВАЛЬНИК ЗАВДАНЬ WINDOWS
# =============================================
# BRAVO_TASKS_INSTALL.ps1 створює або оновлює ці завдання.
# Час задається у локальному часі сервера у форматі HH:mm.
$global:schedulerSettings = @{
    TaskPath = "\BRAVO\"
    LegacyTaskPath = "\ARCHIV_LIMS\"
    LegacyTaskNames = @("ARCHIV_LIMS_BACKUP", "ARCHIV_LIMS_HEALTH")
    PowerShellExecutable = Join-Path $env:SystemRoot "System32\WindowsPowerShell\v1.0\powershell.exe"
    WindowStyle = "Hidden"
    # Системний обліковий запис дозволяє виконувати нічні завдання без
    # активного входу користувача. Перед встановленням завдань збережіть
    # потрібні секрети через BRAVO_CREDENTIALS_SETUP.ps1 для ScheduledTaskAccount.
    RunAsUser = "SYSTEM"
    LogonType = "ServiceAccount"

    # Пропущені щоденні Backup/Maintenance виконує Recovery (-RunMissedRestoreOnly,
    # незалежно від того, boot-trigger чи daily-trigger його викликав), у
    # контрольованому порядку maintenance -> archive.
    # Це значення застосовується до Backup/Maintenance/Health/BAZASync.
    # Recovery — виняток: New-BRAVOTaskDefinition (BRAVO_TASKS_INSTALL.ps1)
    # завжди примусово ставить StartWhenAvailable=true для нього, незалежно
    # від цього ключа, — безпечно лише завдяки P0 TOCTOU-переперевірці
    # вікна безпосередньо в BRAVO_MAINTENANCE.ps1 (запізніле надолуження
    # поза вікном коректно no-op).
    StartWhenAvailable = $false
    WakeToRun = $false
    Hidden = $true
    AllowStartIfOnBatteries = $true
    DontStopIfGoingOnBatteries = $true
    RestartCount = 3
    RestartIntervalMinutes = 15
    MultipleInstances = "IgnoreNew"
    # Backup і maintenance використовують спільний lock. Друге завдання
    # очікує звільнення lock замість накладання операцій або негайного fail.
    OperationLockWaitMinutes = 360
    # Встановлювач відхиляє SYSTEM-завдання, якщо каталог скриптів має право
    # запису для звичайних локальних користувачів. Вимкнення цієї перевірки
    # допускається лише як тимчасова міграція.
    RequireProtectedRuntime = $true

    Backup = @{
        Enabled = $true
        TaskName = "BRAVO_ARCHIV"
        Description = "Щоденна архівація та передача резервних копій BRAVO"
        ScriptPath = Join-Path $runtimeRoot "BRAVO_ARCHIV.ps1"
        DailyAt = "23:00"
        ExecutionTimeLimitHours = 30
    }

    Maintenance = @{
        Enabled = $true
        TaskName = "BRAVO_MAINTENANCE"
        Description = "Щоденне обслуговування служб і даних BRAVO"
        ScriptPath = Join-Path $runtimeRoot "BRAVO_MAINTENANCE.ps1"
        DailyAt = "23:55"
        ExecutionTimeLimitHours = 18
    }

    Health = @{
        Enabled = $true
        TaskName = "BRAVO_ARCHIV_HEALTH"
        Description = "Перевірка локальних, SFTP і SMB резервних копій BRAVO кожні 240 хвилин"
        ScriptPath = $backupHealthScriptPath
        StartAt = "00:15"
        RepeatEveryMinutes = 240
        ExecutionTimeLimitHours = 2
        SkipIfBackupTaskRunning = $true
    }

    # Recovery-завдання реєструється ЛИШЕ на серверах робочого часу
    # (Restore.BootRestoreMode="HoldServices"): один boot-trigger без
    # repetition — пропущена реставрація виконується одразу після старту
    # сервера, поки служби (Automatic Delayed Start) ще не запущені.
    # На 24/7-серверах ("None") завдання не потрібне: пропущений слот
    # підхоплює щонічне Maintenance у вікні Restore.WindowStart-WindowEnd,
    # і інсталятор видаляє раніше зареєстроване Recovery-завдання.
    Recovery = @{
        Enabled = ([string]$maintenanceSettings.Restore.BootRestoreMode -eq "HoldServices")
        TaskName = "BRAVO_RESTORE_RECOVERY"
        Description = "Підхоплення пропущеної планової реставрації моделі одразу після старту сервера (профіль робочого часу)"
        ScriptPath = Join-Path $runtimeRoot "BRAVO_MAINTENANCE.ps1"
        ExecutionTimeLimitHours = 18
        StartupDelayMinutes = $maintenanceSettings.Restore.StartupDelayMinutes
    }

    # BAZASync — суто SFTP-синхронізація BAZA_APP/BAZA_WWW (BRAVO_ARCHIV -SyncBAZA).
    # Enabled береться з канонічного $bazaSyncEffective (APP_SFTP OR WWW_SFTP),
    # тому валідна пара BAZA_APP_SFTP=$false / BAZA_WWW_SFTP=$true теж вмикає
    # завдання. Раніше цей вузол синтезував ЛИШЕ Installer (тільки з
    # BAZA_APP_SFTP), а Diagnose завжди пропускав BAZASync, бо його не було в
    # schedulerSettings — тепер обидва бачать те саме визначення.
    BAZASync = @{
        Enabled = $bazaSyncEffective.ScheduledSftpSyncRequired
        TaskName = "BRAVO BAZA Synchronization"
        Description = "Синхронізація BAZA_APP/BAZA_WWW із хмарним SFTP кожні 4 години"
