    "legacyArchiveStubs": [
      "ARCHIV\\vet_control_20260115_0300.mdz",
      "ARCHIV\\vet_control_20260116_0300.mdz"
    ]
  },
  "services": [
    {
      "Name": "BRAVO",
      "DisplayName": "BRAVO Service",
      "State": "Running",
      "StartMode": "Auto",
      "PathName": "\"{{VETOFFICE_ROOT}}\\bravo.exe\" -k runservice",
      "DependsOn": []
    },
    {
      "Name": "Apache2.4",
      "DisplayName": "Apache2.4",
      "State": "Running",
      "StartMode": "Auto",
      "PathName": "\"{{VETOFFICE_ROOT}}\\apache\\bin\\httpd.exe\" -k runservice",
      "DependsOn": [ "BRAVO" ]
    }
  ],
  "absentServices": [ "exchangAPI" ]
}
